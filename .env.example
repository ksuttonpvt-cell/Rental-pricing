# Rental website settings. start-rentals.bat copies this to .env the first time.
# Edit .env (not this file) in Notepad, then restart the site from Rentals Control.

# Port for the website. Cloudflare's public hostname should point to localhost:<this port>.
PORT=3002
# Port for the Rentals Control window (this PC only).
CONTROL_PORT=3003
# 127.0.0.1 = only this PC (Cloudflare Tunnel runs here). Use 0.0.0.0 to allow other PCs on your network.
HOST=127.0.0.1
# Needed behind Cloudflare so logins and limits work properly.
TRUST_PROXY=1
# Your public web address. Rentals Control uses it to check the site is reachable from the internet.
PUBLIC_URL=https://rentalsaroundtown.com
# Automatic updates from GitHub (main branch). Set to 0 to turn them off.
AUTO_UPDATE=1
UPDATE_CHECK_MINUTES=5
# How long a staff login lasts, in hours.
SESSION_HOURS=12
